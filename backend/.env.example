# swing.io - Environment Variables
# Copy to .env and fill in values

# Finnhub API (free tier - get key at https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Frontend URL (for CORS) — set to your Cloudflare Pages domain in production
FRONTEND_URL=http://localhost:5173
# Additional CORS origins (comma-separated, optional)
# FRONTEND_URLS=https://swing-io.pages.dev,https://your-custom-domain.com

# Auth — jeśli ustawione, dostęp do API wymaga logowania (frontend pokaże ekran logowania)
# Puste = bez auth (dla lokalnego dev)
APP_PASSWORD=

# Email alerts — preferowany Resend (https://resend.com — free 3000/mies, działa na Railway)
RESEND_API_KEY=
RESEND_FROM=swing.io <onboarding@resend.dev>
ALERT_RECIPIENT=your_email@gmail.com
ALERTS_ENABLED=false

# SMTP fallback (Railway BLOKUJE wychodzące SMTP — działa tylko lokalnie)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
